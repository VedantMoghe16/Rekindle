DATABASE_URL="file:./dev.db"
DEMO_TODAY=2026-10-04
APP_BASE_URL=http://localhost:3000

# Claude (structured extraction, ICP compile, drafts, campaigns)
ANTHROPIC_API_KEY=
LLM_MODEL_SMART=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-4-5
# true = cache-only; uncached calls fall back to deterministic engines
LLM_OFFLINE=true

# Sarvam: voice notes (bulbul:v3), speech-to-text (saaras:v3) and the Vyapar SDR voice agent. Drafts use Gemini unless SARVAM_DRAFTS=true
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_LLM_MODEL=sarvam-105b
TRANSCRIBE_PROVIDER=none

# Cognee memory: run the SDK bridge with `npm run cognee:server` (see docs/vyapar/cognee.md)
COGNEE_BASE_URL=http://127.0.0.1:8765
COGNEE_API_KEY=
COGNEE_DATASET=vyapar

# n8n (publish campaigns to LinkedIn/X, scheduled signal collection, engagement callbacks)
N8N_CAMPAIGN_WEBHOOK_URL=
N8N_SHARED_SECRET=

SOURCE_TIMEOUT_MS=8000

# Vyapar AI (Paytm for Business merchant sales)
# One n8n webhook; the workflow branches on `event` (action.requested | campaign.launch | message.send)
N8N_VYAPAR_WEBHOOK_URL=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# Gemini (default LLM when GEMINI_API_KEY is set; override with LLM_PROVIDER=anthropic|gemini|sarvam)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Sarvam voice agent "Vyapar SDR" (see docs/vyapar/sarvam-agent.md). Live calls only go to DEMO_KARAN_PHONE.
SARVAM_VA_BASE=https://apps.sarvam.ai
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=
PUBLIC_BASE_URL=
VYAPAR_WEBHOOK_SECRET=
DEMO_KARAN_PHONE=

# Demo channels: every AI call rings DEMO_CALL_PHONE; "Send on WhatsApp" is delivered to this Telegram chat via the bot.
DEMO_CALL_PHONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VYAPAR_TELEGRAM_CHAT_ID=
SARVAM_VA_API_KEY=
