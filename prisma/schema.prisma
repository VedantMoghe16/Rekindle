generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SellerProfile {
  id               String   @id
  name             String
  oneLiner         String
  product          String
  icp              String
  personasJson     String
  proofPointsJson  String
  roleKeywordsJson String
  changelogJson    String
  repName          String
  updatedAt        DateTime @updatedAt
}

model Account {
  id              String            @id
  name            String
  domain          String?
  industry        String?
  sizeBand        String?
  city            String?
  careersProvider String            @default("none")
  careersToken    String?
  isDemo          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  contacts        Contact[]
  deals           Deal[]
  signals         Signal[]
  engagements     EngagementEvent[]
}

model Contact {
  id        String  @id
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  role      String  @default("unknown")
}

model Deal {
  id              String           @id
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerName       String
  valueInr        Int
  stage           String           @default("stalled")
  stalledAt       DateTime?
  lastTouchAt     DateTime?
  lane            String           @default("WATCH")
  priorityScore   Int              @default(0)
  matchScore      Int              @default(0)
  interactions    Interaction[]
  memory          Memory?
  recommendations Recommendation[]
  laneChanges     LaneChange[]
  outcomes        Outcome[]
}

model Interaction {
  id               String   @id
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  channel          String
  occurredAt       DateTime
  rawText          String
  normalizedText   String
  contentHash      String   @unique
  audioFile        String?
  transcriptCached Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Memory {
  id                    String    @id
  dealId                String    @unique
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stallCategory         String
  summary               String
  evidenceQuote         String
  evidenceSpeaker       String?
  evidenceDate          DateTime?
  evidenceInteractionId String?
  evidenceVerified      Boolean   @default(true)
  timingJson            String
  competitorJson        String
  missingFeatureJson    String
  stakeholdersJson      String
  commitmentsJson       String
  sentiment             String
  language              String
  confidence            Float
  editedByUser          Boolean   @default(false)
  updatedAt             DateTime  @updatedAt
}

model Signal {
  id         String   @id
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dealId     String?
  type       String
  title      String
  detail     String?
  sourceName String
  sourceUrl  String?
  occurredAt DateTime
  detectedAt DateTime @default(now())
  provenance String
  stale      Boolean  @default(false)
  rawJson    String?
  dedupeKey  String   @unique
}

model Recommendation {
  id                 String    @id
  dealId             String
  deal               Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  signalIdsJson      String
  effect             String
  matchScore         Int
  priorityScore      Int
  lane               String
  headline           String
  explanation        String
  scoreBreakdownJson String
  status             String    @default("new")
  snoozedUntil       DateTime?
  isCurrent          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  drafts             Draft[]
}

model LaneChange {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromLane  String
  toLane    String
  reason    String
  createdAt DateTime @default(now())
  seen      Boolean  @default(false)
}

model DiscoveryThread {
  id                  String        @id
  title               String
  currentCriteriaJson String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  messages            ChatMessage[]
  icpVersions         IcpVersion[]
  researchRuns        ResearchRun[]
}

model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  thread    DiscoveryThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime        @default(now())
}

model IcpVersion {
  id           String          @id @default(cuid())
  threadId     String
  thread       DiscoveryThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  version      Int
  prompt       String
  criteriaJson String
  createdAt    DateTime        @default(now())

  @@unique([threadId, version])
}

model ResearchRun {
  id           String          @id @default(cuid())
  threadId     String
  thread       DiscoveryThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  criteriaJson String
  status       String          @default("completed")
  resultCount  Int
  isDemo       Boolean         @default(true)
  createdAt    DateTime        @default(now())
}

model LeadCandidate {
  id                String         @id
  name              String
  domain            String         @unique
  industry          String
  city              String
  sizeBand          String
  fundingStage      String?
  fitScore          Int
  timingScore       Int
  overallScore      Int
  confidence        String
  suggestedPersona  String
  whyFitJson        String
  tagsJson          String
  status            String         @default("SUGGESTED")
  promotedAccountId String?
  isDemo            Boolean        @default(true)
  source            String         @default("demo")
  companyId         String?
  enrichedAt        DateTime?
  stale             Boolean        @default(false)
  createdAt         DateTime       @default(now())
  evidence          LeadEvidence[]
}

model LeadEvidence {
  id          String        @id
  candidateId String
  candidate   LeadCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  excerpt     String
  sourceName  String
  sourceUrl   String?
  observedAt  DateTime
  confidence  String
  isDemo      Boolean       @default(true)
  provenance  String        @default("demo")
}

model Company {
  id              String    @id
  name            String
  domain          String    @unique
  industry        String
  city            String
  sizeBand        String
  fundingStage    String?
  careersProvider String    @default("none")
  careersToken    String?
  tagsJson        String
  website         String?
  description     String?
  source          String    @default("curated")
  lastEnrichedAt  DateTime?
  createdAt       DateTime  @default(now())
}

model LlmCache {
  key        String   @id
  provider   String
  model      String
  schemaName String
  response   String
  createdAt  DateTime @default(now())
}

model SourceCache {
  key       String   @id
  response  String
  fetchedAt DateTime @default(now())
}

model Draft {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  channel          String
  language         String         @default("en")
  subject          String?
  body             String
  whyJson          String
  provenance       String         @default("computed")
  createdAt        DateTime       @default(now())
}

model Campaign {
  id                   String            @id @default(cuid())
  stallCategory        String
  name                 String
  coreMessage          String
  recommendedPlatform  String
  platformRationale    String
  assetsJson           String
  targetAccountIdsJson String
  status               String            @default("draft")
  launchedAt           DateTime?
  postUrlsJson         String?
  provenance           String            @default("computed")
  createdAt            DateTime          @default(now())
  engagements          EngagementEvent[]
}

model EngagementEvent {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String   @default("linkedin")
  type        String
  roleTitle   String?
  occurredAt  DateTime @default(now())
  isSimulated Boolean  @default(true)
}

model Outcome {
  id               String   @id @default(cuid())
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recommendationId String?
  stallCategory    String
  signalType       String?
  event            String
  isSeeded         Boolean  @default(false)
  occurredAt       DateTime @default(now())
}

// ===== Vyapar AI (Paytm for Business merchant-to-merchant sales) =====
// DECISION: a separate merchant domain rather than overloading the SaaS Account/Deal models,
// so the legacy Rekindle screens keep working while Vyapar AI becomes the product.

/// A Paytm merchant from onboarding data (KYC geo, MCC, GSTIN, QR volume) plus public web enrichment.
model Merchant {
  id            String          @id
  mid           String?         @unique
  name          String
  ownerName     String
  category      String
  mcc           String
  area          String
  city          String
  lat           Float
  lng           Float
  phoneMasked   String?
  gstinMasked   String?
  qrVolumeBand  String
  monthlyTxns   Int?
  rating        Float?
  reviewCount   Int?
  language      String          @default("hinglish")
  profileJson   String          @default("{}")
  signalsJson   String          @default("[]")
  isDemo        Boolean         @default(true)
  /// "demo" = fictional Paytm merchant fixture; "osm" = real public listing from OpenStreetMap (ODbL).
  source        String          @default("demo")
  osmId         String?         @unique
  street        String?
  cuisine       String?
  openingHours  String?
  website       String?
  /// National or regional chain: buys centrally, excluded by the eligibility gate.
  brand         String?
  /// "verified" = opted-in business contact (demo fixture); "unknown" = no permitted contact route.
  contactStatus String          @default("unknown")
  contactRole   String?
  /// "verified" only for demo Paytm merchants; public listings are "unknown".
  paytmStatus   String          @default("unknown")
  observedAt    String?
  createdAt     DateTime        @default(now())
  seller        VyaparSeller?
  leads         VyaparLead[]
  deals         VyaparDeal[]
  memories      VyaparMemory[]
}

/// The merchant using Vyapar AI to sell, with what they sell and the offers the AI may use.
model VyaparSeller {
  id             String     @id
  merchantId     String     @unique
  merchant       Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ownerFirstName String
  /// male | female: the voice and Hindi grammar the AI uses when it speaks for the seller (null = not chosen yet)
  ownerGender    String?
  product        String
  productCategory String
  unitPriceInr   Float
  offersJson     String
  autopilot      Boolean    @default(true)
  updatedAt      DateTime   @updatedAt
}

/// One "find me buyers" request compiled into a plan and run against the merchant graph.
model VyaparHunt {
  id         String       @id @default(cuid())
  prompt     String
  planJson   String
  provenance String       @default("rules")
  scanned    Int          @default(0)
  createdAt  DateTime     @default(now())
  leads      VyaparLead[]
}

model VyaparLead {
  id          String      @id @default(cuid())
  huntId      String
  hunt        VyaparHunt  @relation(fields: [huntId], references: [id], onDelete: Cascade)
  merchantId  String
  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fitScore    Int
  distanceKm  Float
  reasonsJson String
  status      String      @default("SUGGESTED")
  excluded    String?
  pitchJson   String?
  dealId      String?
  /// Snapshot of the opportunity at search time (never rewritten by later feedback).
  opportunityJson String?
  position    Int?
  rankerVersion String?
  createdAt   DateTime    @default(now())

  @@unique([huntId, merchantId])
}

model VyaparDeal {
  id          String          @id @default(cuid())
  merchantId  String
  merchant    Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  stage       String          @default("PITCHED")
  valueInr    Int
  objection   String?
  nextStep    String?
  autopilot   Boolean         @default(true)
  /// Demo routing overrides set by a fleet run (which Telegram chat / phone stands in for this merchant).
  demoPhone   String?
  demoChatId  String?
  lastTouchAt DateTime
  createdAt   DateTime        @default(now())
  messages    VyaparMessage[]
  memories    VyaparMemory[]
  actions     VyaparAction[]
}

model VyaparMessage {
  id         String     @id @default(cuid())
  dealId     String
  deal       VyaparDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  direction  String
  kind       String     @default("text")
  text       String
  author     String
  provider   String?
  metaJson   String     @default("{}")
  createdAt  DateTime
}

model VyaparMemory {
  id         String     @id @default(cuid())
  dealId     String
  deal       VyaparDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kind       String
  category   String?
  summary    String
  quote      String?
  verified   Boolean    @default(false)
  resolved   Boolean    @default(false)
  createdAt  DateTime
}

model VyaparAction {
  id          String     @id @default(cuid())
  dealId      String
  deal        VyaparDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type        String
  status      String
  summary     String
  payloadJson String
  ref         String?
  provider    String     @default("simulated")
  createdAt   DateTime
}

model VyaparCampaign {
  id          String   @id @default(cuid())
  objection   String
  headline    String
  assetsJson  String
  audience    Int
  status      String   @default("draft")
  provider    String   @default("rules")
  createdAt   DateTime @default(now())
}

/// Explicit seller feedback that personalises ranking (skip reasons, saves, clarifications). Undo sets active=false.
model VyaparPreference {
  id         String   @id @default(cuid())
  sellerId   String
  kind       String
  reason     String?
  merchantId String?
  category   String?
  value      String?
  label      String
  active     Boolean  @default(true)
  huntId     String?
  createdAt  DateTime @default(now())
  undoneAt   DateTime?
}

/// Decision and outcome log for a future learned ranker. provenance: simulated | demo | live.
model VyaparEvent {
  id            String   @id @default(cuid())
  sellerId      String
  type          String
  huntId        String?
  leadId        String?
  merchantId    String?
  dealId        String?
  position      Int?
  rankerVersion String?
  provenance    String   @default("simulated")
  metaJson      String   @default("{}")
  createdAt     DateTime @default(now())
}

// ===== Buyer needs (VYAPAR_BUYER_NEEDS_IMPLEMENTATION_PLAN.md, Release A, simplified) =====

/// A seller's current, structured offer for one product. Money in paise. Stock is a dated seller promise, not a reservation.
model VyaparOffer {
  id               String    @id
  sellerMerchantId String
  productKey       String
  name             String
  unit             String
  unitPricePaise   Int
  tiersJson        String    @default("[]")
  moq              Int
  stockQty         Int?
  stockStatus      String
  confirmedAt      DateTime?
  deliveryRadiusKm Float
  leadTimeHours    Int
  sampleAvailable  Boolean
  sampleNote       String?
  provenance       String    @default("demo")
}

/// A buyer-confirmed purchase need. Unknown budget stays null; it is never zero.
model VyaparNeed {
  id                String               @id @default(cuid())
  buyerMerchantId   String
  status            String               @default("OPEN")
  rawInput          String
  productKey        String
  quantity          Int
  maxUnitPricePaise Int?
  neededBy          String
  sampleFirst       Boolean              @default(false)
  backupSupplier    Boolean              @default(false)
  provenance        String               @default("demo")
  createdAt         DateTime
  introductions     VyaparIntroduction[]
}

/// The buyer chose this seller for this need: only this seller may contact them about it.
model VyaparIntroduction {
  id               String     @id @default(cuid())
  needId           String
  need             VyaparNeed @relation(fields: [needId], references: [id], onDelete: Cascade)
  offerId          String
  sellerMerchantId String
  status           String     @default("REQUESTED")
  termsJson        String
  dealId           String?
  createdAt        DateTime
  respondedAt      DateTime?

  @@unique([needId, sellerMerchantId])
}

// ===== Autonomous AI sales team (onboarding, fleet runs, demo routing, business memory) =====

/// What the AI team knows about the business: the onboarding answers plus Gemini's plain-language brief.
model VyaparOnboarding {
  id          String   @id @default(cuid())
  sellerId    String   @unique
  answersJson String
  brief       String
  provider    String   @default("rules")
  updatedAt   DateTime @updatedAt
}

/// One press of "Run AI sales team": find → re-rank → pitch on Telegram → call one by one → report.
model FleetRun {
  id         String        @id @default(cuid())
  sellerId   String
  status     String        @default("RUNNING")
  step       String        @default("Understanding your business")
  goal       String
  huntId     String?
  /// Shops the merchant chose on the search results (in rank order); null = the team picks from the business brief
  leadIdsJson String?
  callMode   String        @default("live")
  /// When to contact each shop: quiet (fewest payments while open) | after_open | now
  timing     String        @default("quiet")
  report     String?
  error      String?
  createdAt  DateTime
  finishedAt DateTime?
  targets    FleetTarget[]
}

model FleetTarget {
  id             String   @id @default(cuid())
  runId          String
  run            FleetRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  priority       Int
  merchantId     String
  leadId         String?
  dealId         String?
  why            String
  bestTime       String?
  pitch          String?
  telegramStatus String   @default("PENDING")
  callStatus     String   @default("QUEUED")
  attemptId      String?
  outcome        String?
  result         String?
  /// When the team will message and call this shop, and why (from its Paytm payment pattern).
  scheduledFor   DateTime?
  timingNote     String?
  hoursJson      String?
  updatedAt      DateTime @updatedAt
}

/// Demo routing: priority-N target's Telegram messages and calls go to this contact (fictional merchants have none).
model DemoContact {
  priority       Int     @id
  label          String
  phone          String?
  telegramChatId String?
}

/// Plain-language log of everything written to the business memory (Cognee), for non-technical users.
model KnowledgeEvent {
  id        String   @id @default(cuid())
  kind      String
  title     String
  text      String
  dealId    String?
  runId     String?
  cognee    String   @default("skipped")
  createdAt DateTime
}

/// Sarvam Translate cache for the app-wide language switch (one row per string per language).
model Translation {
  id        String   @id // sha1(lang + source text)
  lang      String
  source    String
  text      String
  createdAt DateTime @default(now())
}

/// Follow-up agent: one row per proposed/sent follow-up on a silent deal (see src/lib/vyapar/followups.ts).
model VyaparFollowup {
  id           String    @id @default(cuid())
  dealId       String
  cohort       String
  attempt      Int
  templateId   String
  reason       String
  text         String
  /// PROPOSED (waits for you) | APPROVED (sends at scheduledFor) | SENT | SKIPPED | CANCELLED (they replied / no longer safe)
  status       String    @default("PROPOSED")
  /// low = may auto-send in auto mode | review = always needs approval (price change, lost deal)
  risk         String
  checksJson   String
  provider     String
  scheduledFor DateTime
  timingNote   String?
  autoApproved Boolean   @default(false)
  /// text | voice (Sarvam voice note, used when texts went unanswered)
  channel      String    @default("text")
  /// Why this template and channel were chosen (learning + channel rule), for the seller
  whyJson      String?
  note         String?
  createdAt    DateTime
  decidedAt    DateTime?
  sentAt       DateTime?
  repliedAt    DateTime?

  @@index([dealId])
  @@index([status])
}

/// How much the follow-up agent may do on its own.
model FollowupSettings {
  id       String @id @default("default")
  /// review = every draft waits for approval | auto = low-risk ones send at the quietest hour | off
  mode     String @default("review")
  dailyCap Int    @default(10)
}
