      "id": "1ae1e8b4-3cfd-59d0-b3c2-47047e802a44",
      "name": "List Rekindle campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per real (non-simulated) published post of a launched campaign.\nconst campaigns = $input.first().json.data || [];\nconst items = [];\nfor (const campaign of campaigns) {\n  if (campaign.status !== 'launched') continue;\n  for (const [platform, url] of Object.entries(campaign.postUrls || {})) {\n    if (!url || url.includes('simulated-')) continue;\n    const postId = platform === 'linkedin' ? (url.match(/urn:li:[a-zA-Z]+:\\d+/) || [])[0] : (url.match(/status\\/(\\d+)/) || [])[1];\n    if (postId) items.push({ json: { campaignId: campaign.id, platform, postId, postUrl: url } });\n  }\n}\nreturn items;"
      },
      "id": "d829955f-2329-57a0-9706-61b16f344376",
      "name": "Campaign posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
