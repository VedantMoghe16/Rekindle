        "url": "={{ $env.APP_BASE_URL }}/api/campaigns/{{ $json.campaignId }}",
        "options": {}
      },
      "id": "f0fb5b75-80cb-5233-8a56-09146e931bdb",
      "name": "Campaign targets",
