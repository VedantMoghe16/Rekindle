      "notes": "Placeholder: reaction actors need Community Management API access. Resolve each actor URN to a headline before mapping."
    },
    {
      "parameters": {
        "url": "=https://api.x.com/2/tweets/{{ $('Campaign posts').item.json.postId }}/liking_users?user.fields=description,name,username",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twitterOAuth2Api",
        "options": {}
      },
      "id": "8e511c7b-a825-594d-baf9-01ca87dd4318",
      "name": "X liking users (placeholder)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        400
      ],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "",
          "name": "X account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Placeholder: liking_users requires an X API tier with read access."
    },
    {
      "parameters": {
        "jsCode": "// Map engagers to Rekindle target accounts by company name or domain in their headline / bio.\n// Rekindle dedupes nothing here: send only engagers you have not sent before (staticData keeps a seen-set).\nconst seen = $getWorkflowStaticData('global');\nseen.ids = seen.ids || {};\nconst out = [];\nfor (const [index, item] of $input.all().entries()) {\n  const post = $('Campaign posts').itemMatching(index).json;\n  const detail = $('Campaign targets').itemMatching(index).json.data || { targets: [] };\n  const people = item.json.elements || item.json.data || [];\n  for (const person of people) {\n    const text = `${person.headline || ''} ${person.description || ''} ${person.name || ''} ${person.organization || ''}`.toLowerCase();\n    const target = detail.targets.find((t) => text.includes(t.name.toLowerCase()));\n    if (!target) continue;\n    const key = `${post.campaignId}:${post.platform}:${person.id || person.actor || person.username}`;\n    if (seen.ids[key]) continue;\n    seen.ids[key] = Date.now();\n    out.push({ json: {\n      event: 'engagement',\n      campaignId: post.campaignId,\n      accountId: target.accountId,\n      platform: post.platform,\n      type: item.json.__type || 'like',\n      roleTitle: (person.headline || person.description || '').split(/ at | @ |\\|/)[0].slice(0, 80) || null,\n    } });\n  }\n}\nreturn out;"
      },
      "id": "95a69b80-9bfc-5774-9081-00caecabe01d",
      "name": "Map engagers to accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
