    },
    {
      "parameters": {
        "jsCode": "// Response body for Rekindle's launch call: { postUrls: { linkedin?, x? } }.\nconst postUrls = {};\nfor (const item of $('Merge published posts').all()) postUrls[item.json.platform] = item.json.postUrl;\nreturn [{ json: { postUrls } }];"
      },
