      "id": "ace06aa1-1a8b-51df-819a-ef48de65b5f0",
      "name": "LinkedIn: create post",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [
        900,
        80
      ],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "",
          "name": "LinkedIn account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// LinkedIn returns the share URN (urn:li:share:… or urn:li:ugcPost:…).\nconst ctx = $('Split assets').itemMatching($itemIndex)?.json ?? $('Split assets').first().json;\nconst urn = $json.urn || $json.id || $json['x-restli-id'] || '';\nreturn {\n  json: {\n    event: 'post.published',\n    campaignId: ctx.campaignId,\n    callbackUrl: ctx.callbackUrl,\n    platform: 'linkedin',\n    postUrl: urn ? `https://www.linkedin.com/feed/update/${urn}` : 'https://www.linkedin.com/feed/',\n  },\n};"
      },
      "id": "6f16caba-2d0b-569b-a68e-6d8696ebaabe",
      "name": "LinkedIn post URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        80
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "aa10b4c5-8ab1-55c8-9155-2a9acbaeb8d4",
      "name": "X: first post",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [
        900,
        320
      ],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "",
          "name": "X account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Split assets').all().find((item) => item.json.platform === 'x').json;\nconst head = $('X: first post').first().json;\nreturn [{\n  json: {\n    event: 'post.published',\n    campaignId: ctx.campaignId,\n    callbackUrl: ctx.callbackUrl,\n    platform: 'x',\n    postUrl: `https://x.com/i/web/status/${head.id}`,\n  },\n}];"
      },
      "id": "49944275-fae0-5664-81c7-328aa2e2ccb0",
      "name": "X post URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fan the rest of the thread out as items; each is posted as a reply to the previous tweet.\nconst ctx = $('Split assets').all().find((item) => item.json.platform === 'x').json;\nconst head = $('X: first post').first().json;\nconst thread = ctx.thread || [];\nif (!thread.length) return [];\nreturn thread.map((text, index) => ({ json: { text, index, headId: head.id } }));"
      },
      "id": "de3e8c99-e73e-56be-979a-c64b51073a25",
      "name": "Thread replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
